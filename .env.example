# StageFront Events — Environment Configuration Blueprint
# Target Firebase Project: stagefront-events
# App Name: StageFront Web

# GEMINI_API_KEY: Optional - Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000 in local dev).
APP_URL="http://localhost:3000"
PORT=3000

# ==========================================
# 1. FIREBASE WEB CLIENT CONFIGURATION (VITE_*)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> StageFront Web (Web app)
# ==========================================
VITE_FIREBASE_API_KEY="AIzaSyD2m_yIhihSkt9e1oqdVHo2O7e0zX2eaw4"
VITE_FIREBASE_AUTH_DOMAIN="stagefront-events.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="stagefront-events"
VITE_FIREBASE_STORAGE_BUCKET="stagefront-events.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="220143378300"
VITE_FIREBASE_APP_ID="1:220143378300:web:81ff24ce4e8498cb524ef9"
VITE_FIREBASE_MEASUREMENT_ID="G-3ZHTEE345X"

# ==========================================
# 2. ADMIN AUTHORIZATION (SERVER-SIDE)
# Comma-separated list of authorized administrator emails
# ==========================================
ADMIN_EMAILS="gvajaykumar125@gmail.com,admin@stagefront.com"

# ==========================================
# 3. FIREBASE ADMIN SDK CONFIGURATION (SERVER-SIDE ONLY — NEVER PREFIX WITH VITE_)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Add your single-line Service Account JSON in the Google AI Studio "Secrets / Environment Variables" panel
# or in your local .env file (never paste private keys in chat or frontend code).
# ==========================================
FIREBASE_PROJECT_ID="stagefront-events"
FIREBASE_SERVICE_ACCOUNT_KEY=""
STRICT_FIRESTORE_PERSISTENCE="false"

# Optional alternative credential variables:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/stagefront-events-service-account.json"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@stagefront-events.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==========================================
# 4. RAZORPAY PAYMENT GATEWAY (SERVER-SIDE ONLY — NEVER PREFIX WITH VITE_)
# Strictly use Razorpay TEST MODE credentials (rzp_test_...) during development/testing.
# Live mode keys (rzp_live_...) are blocked while in Test Mode.
# ==========================================
