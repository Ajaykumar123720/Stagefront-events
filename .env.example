# StageFront Events — Environment Configuration Blueprint
# Target Firebase Project: stagefront-events
# App Name: StageFront Web

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# 1. FIREBASE WEB CLIENT CONFIGURATION (VITE_*)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> StageFront Web (Web app)
# ==========================================
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="stagefront-events.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="stagefront-events"
VITE_FIREBASE_STORAGE_BUCKET="stagefront-events.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ==========================================
# 2. FIREBASE ADMIN SDK CONFIGURATION (SERVER-SIDE EXPRESS ONLY)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ==========================================
FIREBASE_PROJECT_ID="stagefront-events"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"stagefront-events","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@stagefront-events.iam.gserviceaccount.com"}'
